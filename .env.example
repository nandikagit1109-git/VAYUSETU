# VayuSetu runtime configuration. Copy to `.env` only to override; the demo
# runs fully offline with the defaults below (docker compose reads this file).

# synthetic | real (real falls back to synthetic with a reason in /api/meta)
DATA_MODE=synthetic

# Coverage tiering (section 5.3)
MIN_GROUND_DAYS=90
MIN_AUX_DAYS=30

# Forecasting (sections 5.6, 7)
WINDOW_DAYS=14
HORIZONS=1,2,3
NEIGHBOR_RADIUS_KM=400

# Federated learning (section 6)
FL_ROUNDS=8
FL_LOCAL_EPOCHS=2
FL_BATCH_SIZE=64
FL_LR=0.001
FL_ENGINE=builtin
MIN_TRAIN_WINDOWS=60
AUTO_TRAIN_ON_START=true

# Data build: true forces a fresh master table at startup
REBUILD_DATA=false

# Reports
REPORT_MAX_DISTANCE_KM=200
PHOTO_MAX_BYTES=5000000

# Determinism
SEED=42
FIRE_RADIUS_KM=500

# SQLite location (inside the backend container)
VAYUSETU_DB_URL=sqlite:///./vayusetu.db
