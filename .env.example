# All values below are SAFE DEFAULTS — the demo runs fully offline without
# copying this file. Copy to .env only if you want to change something.

# SQLite file location (relative to backend/)
VAYUSETU_DB_URL=sqlite:///./vayusetu.db

# Optional stretch: real SMS via Twilio (OFF by default — alerts are simulated)
ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional stretch: live satellite fire API (OFF by default — mock JSON is used)
ENABLE_LIVE_SATELLITE=false
